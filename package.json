{
	"name": "study-coach",
	"version": "0.1.0",
	"description": "A local study coach for Microsoft certification exams, starting with AZ-104.",
	"license": "MIT",
	"author": "Ythalo Saldanha",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"check:doc-urls": "node scripts/check-doc-urls.ts",
		"check:types": "tsc --noEmit && tsc -p web",
		"db:setup": "node scripts/db-setup.ts",
		"dev": "run-p dev:server dev:web",
		"dev:server": "vite dev --host 127.0.0.1 --port 8787",
		"dev:web": "vite --config web/vite.config.ts",
		"docs:sheets": "node scripts/docs-sheets.ts",
		"docs:review": "node scripts/docs-review.ts",
		"docs:sync": "node scripts/docs-sync.ts",
		"evals": "vitest run --config vitest.evals.config.ts",
		"generate": "node scripts/generate.ts",
		"generate:stats": "node scripts/generate-stats.ts",
		"questions:export": "node scripts/questions-export.ts",
		"questions:lint": "node scripts/questions-lint.ts",
		"questions:reverify": "node scripts/questions-reverify.ts",
		"questions:review": "node scripts/questions-review.ts",
		"review:sheet": "node scripts/review-sheet.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"@flue/react": "^2.3.0",
		"@flue/runtime": "^2.3.0",
		"@flue/sdk": "^2.3.0",
		"@flue/vite": "^2.3.0",
		"hono": "^4.13.13",
		"marked": "^15.0.12",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"sanitize-html": "2.18.0",
		"valibot": "^1.5.0",
		"vite": "^8.3.4"
	},
	"devDependencies": {
		"@flue/cli": "^2.3.0",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22.10.10",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@types/sanitize-html": "^2.16.2",
		"@vitejs/plugin-react": "^6.1.2",
		"jsdom": "^29.1.1",
		"npm-run-all2": "^8.0.4",
		"typescript": "^7.0.2",
		"vitest": "^4.1.12"
	}
}
