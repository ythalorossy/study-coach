# Copy this file to .env and fill in your values. `.env` is git-ignored.
# `flue run`, `vite dev` and the npm scripts load it automatically.

# API key for the model provider. The default model for every role is
# minimax/MiniMax-M3, so a MiniMax key is enough to start.
# Any provider Pi supports works: https://pi.dev/docs/latest/providers#api-keys
MINIMAX_API_KEY=

# Other providers, only needed if a model below uses them:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Model per role, written as provider/model. Leave unset for the defaults.
# COACH_MODEL=minimax/MiniMax-M3        # lead instructor
# SPECIALIST_MODEL=                     # area instructors (default: COACH_MODEL)
# WRITER_MODEL=minimax/MiniMax-M3       # question writer
# VERIFIER_MODEL=                       # blind re-answer of each question (default: WRITER_MODEL)
# FACT_SHEET_MODEL=                     # fact-sheet writer (default: WRITER_MODEL)

